# Public values only -- everything here is baked into the client bundle
# and visible to anyone, by design (Vite only exposes VITE_-prefixed vars).

# Your A-Commie API's public URL (no trailing slash).
VITE_API_BASE_URL=https://api.yourdomain.com

# Same Client ID as your bot's Discord application (OAuth2 tab).
VITE_DISCORD_CLIENT_ID=

VITE_SUPPORT_SERVER_URL=https://discord.gg/your-invite
VITE_BOT_INVITE_PERMISSIONS=8
